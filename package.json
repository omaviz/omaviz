{
  "name": "omaviz",
  "version": "8.5.2",
  "private": true,
  "description": "Omarchy audio visualizer plugin (QML + bundled Rust engine)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.cjs\"",
    "test:engine": "node --test tests/engine.test.cjs",
    "test:physics": "node --test tests/physics.test.cjs",
    "test:store": "node --test tests/modelstore.test.cjs",
    "test:qml": "node tests/components.cjs",
    "lint:qml": "qmllint *.qml",
    "build": "./build.sh",
    "test:rust": "cd engine && cargo test",
    "verify": "npm run test && npm run test:installer && npm run test:rust",
    "test:installer": "./tests/installer.test.sh",
    "test:render": "node tools/render/compare.cjs"
  }
}
