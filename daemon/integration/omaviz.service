[Unit]
Description=omaviz audio visualizer daemon
Documentation=https://github.com/local/omaviz
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/omaviz daemon
Restart=on-failure
RestartSec=2
Nice=5
# The DSP is light but latency-sensitive; keep it off the big cores' backlog.
IOSchedulingClass=best-effort

[Install]
WantedBy=default.target
